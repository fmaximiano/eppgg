{
  "printWidth": 100,
  "singleQuote": true,
  "overrides": [
    {
      "files": [
        "*.css",
        "*.html"
      ],
      "options": {
        "singleQuote": false
      }
    },
    {
      "files": [
        "*.html"
      ],
      "options": {
        "htmlWhitespaceSensitivity": "ignore"
      }
    }
  ]
}
